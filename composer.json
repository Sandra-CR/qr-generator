{
    "name": "sandra-cr/qr-generator",
    "description": "Générateur de QR codes personnalisé en PHP pur",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-gd": "*",
        "bacon/bacon-qr-code": "^3.0",
        "chillerlan/php-qrcode": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
